{
  "name": "discord-claude-full-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.martusha89/discord-claude-full-mcp",
  "description": "A full-featured Discord MCP server: text, images, files, voice notes (ElevenLabs TTS), stickers, server emojis, reactions, and more.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "discord-claude-full-mcp": "build/index.js"
  },
  "files": [
    "build",
    "src",
    "tsconfig.json",
    "config.example.json",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martusha89/discord-claude-full-mcp.git"
  },
  "homepage": "https://github.com/martusha89/discord-claude-full-mcp#readme",
  "bugs": {
    "url": "https://github.com/martusha89/discord-claude-full-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/privacy.test.mjs test/security.test.mjs",
    "start": "node build/index.js",
    "dev": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "mcp",
    "claude",
    "elevenlabs",
    "voice-note",
    "model-context-protocol"
  ],
  "author": "Marta Varen",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.16",
    "typescript": "^5.3.3"
  }
}
