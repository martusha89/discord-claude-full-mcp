# Required: Discord bot token
# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Transport mode: "stdio" (default, for Claude Desktop/Code) or "sse" (for claude.ai browser & mobile app)
# When using "sse", the server runs on MCP_HOST:MCP_PORT and exposes /mcp endpoint
MCP_TRANSPORT=stdio
MCP_PORT=3001

# Bind address for HTTP mode. Defaults to 127.0.0.1 (loopback only).
# HTTP mode always requires MCP_AUTH_TOKEN; non-loopback also requires TLS protection.
MCP_HOST=127.0.0.1

# Required for HTTP mode (including loopback). Every /mcp and /health request must send
# "Authorization: Bearer <token>". Generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone who can reach /mcp without this has full control of your bot.
MCP_AUTH_TOKEN=

# Comma-separated list of allowed CORS origins for HTTP mode.
# Defaults to https://claude.ai,https://claude.com
MCP_ALLOWED_ORIGINS=

# Privacy applied before Discord messages leave this process:
#   redacted (default) = content + stable aliases + reply context, without user IDs,
#                        tags, attachment URLs, or embed bodies
#   metadata           = aliases and structural metadata, without message content
#   full               = original full-fidelity response
DISCORD_PRIVACY_MODE=redacted

# Optional separate secret used to keep alias labels stable across Discord token rotation.
# Reverse-routing maps are memory-only and are rebuilt whenever messages are read.
DISCORD_PRIVACY_ALIAS_KEY=

# Include supported Discord image attachments as actual MCP image content so the
# AI can see them. Set false to return attachment metadata only.
DISCORD_INCLUDE_IMAGES=true

# Configurable combined image-pixel ceiling per read_messages call (25 MiB).
DISCORD_MAX_IMAGE_CONTEXT_BYTES=26214400

# Maximum decoded pixels per image during validation (40 megapixels by default).
DISCORD_MAX_IMAGE_PIXELS=40000000

# Overall image download + validation deadline per read_messages call (30 seconds).
DISCORD_IMAGE_READ_TIMEOUT_MS=30000

# Local file attachments are disabled unless one or more approved directory roots
# are listed here, separated by commas. Remote attachments require public HTTPS.
DISCORD_ALLOWED_FILE_ROOTS=

# Configurable technical ceiling for local and remote attachment memory use (25 MiB).
DISCORD_MAX_ATTACHMENT_BYTES=26214400

# Optional: ElevenLabs API key (only needed if you want send_voice_note to work)
# Voice and model settings are configured in config.json
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice settings. Both send_voice_note requirements
# (key + voice id) must be present or the tool stays hidden.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Optional: server used when a tool call omits the "server" argument
# and the bot is in more than one server.
DISCORD_DEFAULT_GUILD_ID=
