# Required: Discord bot token
# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: ElevenLabs API key (only needed if you want send_voice_note to work)
# Get one at https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice settings. Both send_voice_note requirements
# (key + voice id) must be present or the tool stays hidden.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Optional: server used when a tool call omits the "server" argument
# and the bot is in more than one server.
DISCORD_DEFAULT_GUILD_ID=
